{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODDABLE)/modules/io/manifest.json",
    "../util/manifest.json",
    "../io-expander/manifest.json"
  ],
  "modules": {
    "motion-controller": "./motion-controller",
    "m5stackchan-servo": "./m5stackchan-servo",
    "m5stackchan-servo-driver": "./m5stackchan-servo-driver",
    "none-driver": "./none-driver",
    "protocols/scservo": "./protocols/scservo",
    "protocols/scservo-codec": "./protocols/scservo-codec",
    "protocols/scservo-decoder": "./protocols/scservo-decoder",
    "single-wait-slot": "./internal/single-wait-slot",
    "servo-command-error": "./internal/servo-command-error"
  },
  "preload": [
    "motion-controller",
    "m5stackchan-servo",
    "m5stackchan-servo-driver",
    "none-driver",
    "protocols/scservo",
    "protocols/scservo-codec",
    "protocols/scservo-decoder",
    "single-wait-slot",
    "servo-command-error"
  ],
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false,
        "strictNullChecks": false,
        "strictPropertyInitialization": false,
        "strictFunctionTypes": false
      }
    }
  }
}
