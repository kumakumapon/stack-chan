{
  "include": [
    "../../../modules/ui/manifest.json",
    "../../../modules/testing/manifest.json"
  ],
  "modules": {
    "companion-idle": "../../companion-idle",
    "memory-game": "../../memory-game",
    "memory-game-mini-app": "../../memory-game-mini-app",
    "main": "./memory-game.test"
  },
  "preload": ["companion-idle"],
  "resources": {
    "*": ["../../strings/*"],
    "*-mask": [
      {
        "source": "../../../modules/ui/assets/fonts/k8x12",
        "size": 12,
        "characterFiles": "../../../modules/ui/assets/fonts/k8x12-chars.txt",
