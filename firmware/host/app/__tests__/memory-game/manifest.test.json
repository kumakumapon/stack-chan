      }
    ],
    "*-alpha": [
      {
        "source": "../../../modules/ui/assets/fonts/k8x12",
        "size": 24,
        "characters": "0123456789",
        "monochrome": true
      }
    ]
  },
  "creation": {
    "static": 110592,
    "chunk": { "initial": 2048, "incremental": 512 },
    "heap": { "initial": 768, "incremental": 128 },
    "stack": 512,
    "keys": { "available": 512 }
  }
