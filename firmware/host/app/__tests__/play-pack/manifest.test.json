{
  "include": [
    "../../../modules/ui/manifest.json",
    "../../../modules/testing/manifest.json"
  ],
  "modules": {
    "companion-idle": "../../companion-idle",
    "janken-game": "../../janken-game",
    "janken-mini-app": "../../janken-mini-app",
    "quick-tap-game": "../../quick-tap-game",
    "quick-tap-mini-app": "../../quick-tap-mini-app",
    "fortune": "../../fortune",
    "fortune-mini-app": "../../fortune-mini-app",
    "play-pack-drawing": "../../play-pack-drawing",
    "play-pack-strings": "../../play-pack-strings",
    "play-pack-text": "../../play-pack-text",
    "main": "./play-pack.test"
  },
  "preload": [
    "companion-idle",
    "janken-mini-app",
    "quick-tap-mini-app",
    "fortune-mini-app",
    "play-pack-text"
  ],
  "resources": {
    "*": ["../../strings/*"],
    "*-mask": [
      {
        "source": "../../../modules/ui/assets/fonts/k8x12",
        "size": 12,
        "characterFiles": "../../../modules/ui/assets/fonts/k8x12-chars.txt",
        "localization": true,
        "monochrome": true
      }
    ],
    "*-alpha": [
      {
        "source": "../../../modules/ui/assets/fonts/k8x12",
        "size": 24,
        "characters": "0123456789",
        "monochrome": true
      }
    ]
  },
  "creation": {
    "static": 131072,
    "chunk": {
      "initial": 2048,
      "incremental": 512
    },
    "heap": {
      "initial": 768,
      "incremental": 128
    },
    "stack": 512,
    "keys": {
      "available": 512
    }
  }
}
