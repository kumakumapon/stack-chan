{
  "include": [
    "./manifest.json",
    "./docks/manifest_conversation.json",
    "../modules/usb-audio/manifest.json"
  ],
  "creation": {
    "chunk": {
      "initial": 524288,
      "incremental": 0
    }
  },
  "modules": {
    "~": [
      "$(MODDABLE)/typings/package.json",
      "$(MODDABLE)/typings/tsconfig.es2024.json",
      "$(MODDABLE)/typings/tsconfig.es2025.json"
    ],
    "mod-installer": "./mod-installer",
    "mod-manager": "./mod-manager"
  },
  "config": {
    "enablePowerButton": true,
    "usbAudio": {
      "enabled": false,
      "autoStart": false
    }
  }
}
