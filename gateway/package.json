{
  "name": "stackchan-conversation-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Conversation Gateway for Stack-chan: session hub between the robot and an interchangeable AI Agent backend",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "stackchan-gateway": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/main.js",
    "start:desktop": "node dist/desktop/main.js --open",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:python": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "check": "biome ci . --error-on-warnings"
  },
  "dependencies": {
    "ws": "8.21.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "22.20.3",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
